# 가상환경 (프로젝트 루트 기준)
venv/
.venv/

# 파이썬
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
dist/
build/

# 도구 / IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/

# 로컬·비밀
.env
.env.*
!.env.example

# 백테스트·스캔 실행 산출물 (재생성 가능, 커밋 제외)
output/
outputs/
!outputs/v5_final_report.md

# pykrx 벌크 OHLCV 로컬 캐시(재생성 가능, .gitkeep 만 추적)
data/cache/**
!data/cache/**/
!data/cache/**/.gitkeep

# GUI 마지막 세션(로컬)
config/last_session.json

# v5.3 릴레이 유니버스 스캔 산출물 (run_v5_relay_portfolio.py --scan-only)
config/relay_universes/*
!config/relay_universes/.gitkeep

# v5.1 고정 유니버스 스캔 산출물 (run_v5_breakout.py --scan-universe)
config/kosdaq_sniper_universe.json
config/kosdaq_sniper_universe.meta.json

# v5.5.2 라이브 봇 당일 스캔·포지션 상태 (run_live_bot.py)
config/live_today_universe.json
config/live_today_universe.meta.json
config/live_positions.json

