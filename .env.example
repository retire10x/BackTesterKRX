# 한국투자증권 Open API — 실전
KIS_APP_KEY=
KIS_APP_SECRET=

# 모의투자 (live_settings account.mode=paper 일 때 사용)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# 실전 계좌 (8자리) — real_money 모드
KIS_ACCOUNT_NUMBER=12345678
KIS_ACCOUNT_CODE=01

# 모의투자 계좌 (HTS 모의투자 화면의 8자리, 실전과 다름)
KIS_PAPER_ACCOUNT_NUMBER=

# 개발: API 없이 시뮬레이션 (1=시뮬, 0=실제 API)
LIVE_DRY_RUN=1
# dry_run 시 가상 예수금 (모의 기본 1천만)
LIVE_SIM_CASH=10000000
